---
// Header Component - Extracted from index.html lines 177-269
interface Props {
  logoSrc?: string;
  logoSrcBlack?: string;
  menuItems?: Array<{
    label: string;
    href: string;
    active?: boolean;
    children?: Array<{ label: string; href: string }>;
  }>;
  ctaText?: string;
  ctaUrl?: string;
  searchPlaceholder?: string;
}

const {
  logoSrc = "/assets/img/logo/logo-white.svg",
  logoSrcBlack = "/assets/img/logo/Logo-black.svg",
  menuItems = [],
  ctaText = "Lets Talk",
  ctaUrl = "/contact",
  searchPlaceholder = "Search..."
} = Astro.props;
---

<header class="header-1 header-3" id="header-sticky">
  <div class="container-fluid">
    <div class="mega-menu-wrapper">
      <div class="header-main">
        <div class="logo">
          <a href="/" class="header-logo">
            <img src={logoSrc} alt="logo-img" />
          </a>
          <div class="logo-2">
            <a href="/">
              <img src={logoSrcBlack} alt="" />
            </a>
          </div>
        </div>
        
        <div class="mean__menu-wrapper">
          <div class="main-menu style-2">
            <nav id="mobile-menu">
              <ul>
                {menuItems.map((item) => (
                  <li class={item.active ? "has-dropdown active" : "has-dropdown"}>
                    {item.children && item.children.length > 0 ? (
                      <>
                        <a href={item.href} class={item.active ? "border-none" : ""}>
                          {item.label}
                          <i class="fa-solid fa-chevron-down"></i>
                        </a>
                        <ul class="submenu">
                          {item.children.map((child) => (
                            <li><a href={child.href}>{child.label}</a></li>
                          ))}
                        </ul>
                      </>
                    ) : (
                      <a href={item.href}>{item.label}</a>
                    )}
                  </li>
                ))}
              </ul>
            </nav>
          </div>
        </div>
        
        <div class="header-right d-flex justify-content-end align-items-center">
          <a href="#0" class="search-trigger search-icon">
            <i class="fa-regular fa-magnifying-glass"></i>
          </a>
          <a href={ctaUrl} class="theme-btn style-2">
            {ctaText}
            <i class="fa-sharp fa-regular fa-arrow-right"></i>
          </a>
          <div class="header__hamburger d-xl-none my-auto">
            <div class="sidebar__toggle style-2">
              <i class="fas fa-bars"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>
