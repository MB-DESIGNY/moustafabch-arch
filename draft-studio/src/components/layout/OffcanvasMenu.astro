---
// OffcanvasMenu Component - Extracted from index.html lines 101-176
interface Props {
  logoSrc?: string;
  description?: string;
  contactInfo: {
    address?: string;
    email?: string;
    hours?: string;
    phone?: string;
  };
  socialLinks?: { platform: string; url: string; icon: string }[];
  ctaText?: string;
  ctaUrl?: string;
}

const { 
  logoSrc = "/assets/img/logo/Logo-black.svg",
  description = "",
  contactInfo = {},
  socialLinks = [],
  ctaText = "Consultation",
  ctaUrl = "/contact"
} = Astro.props;
---

<div class="fix-area">
  <div class="offcanvas__info">
    <div class="offcanvas__wrapper">
      <div class="offcanvas__content">
        <div class="offcanvas__top mb-5 d-flex justify-content-between align-items-center">
          <div class="offcanvas__logo">
            <a href="/">
              <img src={logoSrc} alt="logo-img" />
            </a>
          </div>
          <div class="offcanvas__close">
            <button>
              <i class="fas fa-times"></i>
            </button>
          </div>
        </div>
        
        {description && (
          <p class="text d-none d-xl-block">{description}</p>
        )}
        
        <div class="mobile-menu fix mb-3"></div>
        
        <div class="offcanvas__contact">
          <h4>Contact Info</h4>
          <ul>
            {contactInfo.address && (
              <li class="d-flex align-items-center">
                <div class="offcanvas__contact-icon">
                  <i class="fal fa-map-marker-alt"></i>
                </div>
                <div class="offcanvas__contact-text">
                  <a target="_blank" href="#">{contactInfo.address}</a>
                </div>
              </li>
            )}
            
            {contactInfo.email && (
              <li class="d-flex align-items-center">
                <div class="offcanvas__contact-icon mr-15">
                  <i class="fal fa-envelope"></i>
                </div>
                <div class="offcanvas__contact-text">
                  <a href={`mailto:${contactInfo.email}`}>
                    <span class="mailto:info@example.com">{contactInfo.email}</span>
                  </a>
                </div>
              </li>
            )}
            
            {contactInfo.hours && (
              <li class="d-flex align-items-center">
                <div class="offcanvas__contact-icon mr-15">
                  <i class="fal fa-clock"></i>
                </div>
                <div class="offcanvas__contact-text">
                  <a target="_blank" href="#">{contactInfo.hours}</a>
                </div>
              </li>
            )}
            
            {contactInfo.phone && (
              <li class="d-flex align-items-center">
                <div class="offcanvas__contact-icon mr-15">
                  <i class="far fa-phone"></i>
                </div>
                <div class="offcanvas__contact-text">
                  <a href={`tel:${contactInfo.phone}`}>{contactInfo.phone}</a>
                </div>
              </li>
            )}
          </ul>
          
          <div class="header-button mt-4 text-center">
            <a href={ctaUrl} class="theme-btn">
              {ctaText} <i class="fa-solid fa-arrow-right"></i>
            </a>
          </div>
          
          {socialLinks.length > 0 && (
            <div class="social-icon d-flex align-items-center">
              {socialLinks.map((link) => (
                <a href={link.url}>
                  <i class={link.icon}></i>
                </a>
              ))}
            </div>
          )}
        </div>
      </div>
    </div>
  </div>
</div>
<div class="offcanvas__overlay"></div>
