---
// Preloader Component - Extracted from index.html lines 38-79
interface Props {
  loadingText?: string;
  letters?: string[];
}

const { loadingText = "Loading", letters = ["M", "I", "N", "I", "F", "O", "L", "I", "O"] } = Astro.props;
---

<div id="preloader" class="preloader">
  <div class="animation-preloader">
    <div class="spinner"></div>
    <div class="txt-loading">
      {letters.map((letter, index) => (
        <span data-text-preloader={letter} class="letters-loading">
          {letter}
        </span>
      ))}
    </div>
    <p class="text-center">{loadingText}</p>
  </div>
  <div class="loader">
    <div class="row">
      <div class="col-3 loader-section section-left">
        <div class="bg"></div>
      </div>
      <div class="col-3 loader-section section-left">
        <div class="bg"></div>
      </div>
      <div class="col-3 loader-section section-right">
        <div class="bg"></div>
      </div>
      <div class="col-3 loader-section section-right">
        <div class="bg"></div>
      </div>
    </div>
  </div>
</div>
