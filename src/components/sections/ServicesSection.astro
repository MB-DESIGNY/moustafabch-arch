---
// ServicesSection Component
// Services section displaying multiple service cards

import ServiceCard from '../ui/ServiceCard.astro';
import SectionTitle from '../ui/SectionTitle.astro';

export interface ServiceItem {
  slug: string;
  title: string;
  icon: string;
  shortDescription: string;
  comingSoon?: boolean;
}

export interface Props {
  title?: string;
  subtitle?: string;
  services: ServiceItem[];
  viewAllText?: string;
  viewAllHref?: string;
  comingSoonLabel?: string;
}

const {
  title = 'What I Do',
  subtitle = 'SERVICES',
  services,
  viewAllText = 'View All Service',
  viewAllHref = '/services',
  comingSoonLabel = 'Coming Soon'
} = Astro.props;
---

<section class="service-section service-3 section-padding section-bg fix">
  {/* Decorative Shapes */}
  <div class="random-shape float-bob-x">
    <img src="/assets/img/shape/random-shape-3.png" alt="shape" />
  </div>
  
  <div class="container">
    <SectionTitle 
      title={title}
      subtitle={subtitle}
      iconSrc="/assets/img/icon/32.svg"
      align="center"
      style="style-3"
    />
    
    <div class="row">
      {services.slice(0, 6).map((service, index) => (
        <ServiceCard 
          icon={service.icon}
          title={service.title}
          description={service.shortDescription}
          slug={service.comingSoon ? '#' : `/services/${service.slug}`}
          comingSoon={service.comingSoon}
          wowDelay={`${0.3 + (index * 0.3)}s`}
        />
      ))}
    </div>
    
    {viewAllHref && (
      <span class="wow fadeInUp mt-5" data-wow-delay=".3s">
        {viewAllText} <a href={viewAllHref}>View All Service</a>
      </span>
    )}
  </div>
</section>
