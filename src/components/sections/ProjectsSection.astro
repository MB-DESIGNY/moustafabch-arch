---
// ProjectsSection Component
// Projects/Portfolio section displaying project cards

import ProjectCard from '../ui/ProjectCard.astro';
import SectionTitle from '../ui/SectionTitle.astro';

export interface ProjectItem {
  slug: string;
  title: string;
  category: string;
  coverImage: string;
  location?: string;
  year?: string;
}

export interface Props {
  title?: string;
  subtitle?: string;
  projects: ProjectItem[];
  viewAllText?: string;
  viewAllHref?: string;
  featuredLabel?: string;
}

const {
  title = 'My Recent Working Project',
  subtitle = 'CASE STUDIES',
  projects,
  viewAllText = 'View All Project',
  viewAllHref = '/portfolio',
  featuredLabel = 'Featured'
} = Astro.props;
---

<section class="project-section project-3 section-padding section-bg fix">
  {/* Decorative Shapes */}
  <div class="scale-shape float-bob-x">
    <img src="/assets/img/shape/Scales-3.png" alt="img" />
  </div>
  <div class="regulation-shape float-bob-y">
    <img src="/assets/img/shape/regulation.png" alt="img" />
  </div>
  
  <div class="container">
    <div class="section-title-area">
      <SectionTitle 
        title={title}
        subtitle={subtitle}
        iconSrc="/assets/img/icon/32.svg"
        style="style-3"
      />
      {viewAllHref && (
        <a href={viewAllHref} class="theme-btn">
          {viewAllText}
          <i class="fa-solid fa-arrow-right"></i>
        </a>
      )}
    </div>
    
    <div class="project-wrapper-3">
      <div class="main-box">
        {/* Active/Featured Project */}
        {projects.length > 0 && (
          <div class="box-2 active wow fadeInUp">
            <div class="project-content">
              <div class="text">
                <span>{projects[0].category || 'Architecture'}</span>
                <h4><a href={`/portfolio/${projects[0].slug}`}>{projects[0].title}</a></h4>
              </div>
              <a href={`/portfolio/${projects[0].slug}`} class="icon">
                <i class="fa-solid fa-arrow-right"></i>
              </a>
            </div>
          </div>
        )}
        
        {/* Additional Projects */}
        {projects.slice(1, 4).map((project, index) => (
          <ProjectCard 
            coverImage={project.coverImage || '/assets/img/project/default.jpg'}
            category={project.category}
            title={project.title}
            slug={`/portfolio/${project.slug}`}
            bgClass={`bg-${index + 1}`}
            wowDelay={`${0.2 + (index * 0.2)}s`}
          />
        ))}
      </div>
    </div>
  </div>
</section>
