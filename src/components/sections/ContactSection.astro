---
// ContactSection Component
// Contact section with contact info cards and map

export interface Props {
  phoneLabel?: string;
  phoneValue?: string;
  emailLabel?: string;
  emailValue?: string;
  addressLabel?: string;
  addressValue?: string;
  socialLabel?: string;
  socialLinks?: Array<{ href: string; icon: string }>;
  mapSrc?: string;
}

const {
  phoneLabel = 'Call Now',
  phoneValue = '+966 50 000 0000',
  emailLabel = 'Email',
  emailValue = 'info@draftstudio.com',
  addressLabel = 'Address',
  addressValue = 'Riyadh, Saudi Arabia',
  socialLabel = 'Social:',
  socialLinks = [
    { href: '#', icon: 'fa-brands fa-facebook-f' },
    { href: '#', icon: 'fa-brands fa-twitter' },
    { href: '#', icon: 'fa-brands fa-instagram' },
    { href: '#', icon: 'fa-brands fa-linkedin-in' }
  ],
  mapSrc = 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3624.7!2d46.6753!3d24.7136!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMjTCsDQyJzQ5LjAiTiA0NsKwNDAnMzEuMSJF!5e0!3m2!1sen!2ssa!4v1234567890'
} = Astro.props;
---

<section class="contact-from-section pt-0 section-padding fix">
  <div class="container">
    <div class="row g-4">
      {/* Contact Info Column */}
      <div class="col-lg-6">
        <div class="contact-info-box">
          <div class="contact-item wow fadeInUp" data-wow-delay=".2s">
            <div class="icon">
              <i class="fa-solid fa-phone"></i>
            </div>
            <div class="content">
              <span>{phoneLabel}</span>
              <h6>{phoneValue}</h6>
            </div>
          </div>
          <div class="contact-item wow fadeInUp" data-wow-delay=".4s">
            <div class="icon">
              <i class="fa-solid fa-envelope"></i>
            </div>
            <div class="content">
              <span>{emailLabel}</span>
              <h6>{emailValue}</h6>
            </div>
          </div>
          <div class="contact-item wow fadeInUp" data-wow-delay=".6s">
            <div class="icon">
              <i class="fa-solid fa-location-dot"></i>
            </div>
            <div class="content">
              <span>{addressLabel}</span>
              <h6>{addressValue}</h6>
            </div>
          </div>
          
          <div class="social">
            <h6>{socialLabel}</h6>
            <ul class="social-list">
              {socialLinks.map((link, index) => (
                <li 
                  class="wow fadeInUp" 
                  data-wow-delay={`${0.2 + (index * 0.2)}s`}
                >
                  <a href={link.href}>
                    <i class={link.icon}></i>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
      
      {/* Map Column */}
      <div class="col-lg-6">
        <div class="google-map">
          <iframe
            src={mapSrc}
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
          ></iframe>
        </div>
      </div>
    </div>
  </div>
</section>
