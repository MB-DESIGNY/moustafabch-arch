---
// OffcanvasMenu Component
// Offcanvas sidebar with contact info and navigation

export interface Props {
  logoSrc: string;
  description?: string;
  address?: string;
  email?: string;
  phone?: string;
  hours?: string;
  socialLinks?: Array<{ href: string; icon: string }>;
  ctaHref?: string;
  ctaText?: string;
}

const {
  logoSrc,
  description,
  address = 'Main Street, Riyadh, Saudi Arabia',
  email = 'info@draftstudio.com',
  phone = '+966 50 000 0000',
  hours = 'Sun-Thu, 09am -05pm',
  socialLinks = [
    { href: '#', icon: 'fab fa-facebook-f' },
    { href: '#', icon: 'fab fa-twitter' },
    { href: '#', icon: 'fab fa-linkedin-in' },
    { href: '#', icon: 'fab fa-instagram' }
  ],
  ctaHref = '/contact',
  ctaText = 'Consultation'
} = Astro.props;
---

<div class="fix-area">
  <div class="offcanvas__info">
    <div class="offcanvas__wrapper">
      <div class="offcanvas__content">
        <div class="offcanvas__top mb-5 d-flex justify-content-between align-items-center">
          <div class="offcanvas__logo">
            <a href="/">
              <img src={logoSrc} alt="logo-img" />
            </a>
          </div>
          <div class="offcanvas__close">
            <button>
              <i class="fas fa-times"></i>
            </button>
          </div>
        </div>
        
        {description && (
          <p class="text d-none d-xl-block">{description}</p>
        )}
        
        <div class="mobile-menu fix mb-3"></div>
        
        <div class="offcanvas__contact">
          <h4>Contact Info</h4>
          <ul>
            <li class="d-flex align-items-center">
              <div class="offcanvas__contact-icon">
                <i class="fal fa-map-marker-alt"></i>
              </div>
              <div class="offcanvas__contact-text">
                <a target="_blank" href="#">{address}</a>
              </div>
            </li>
            <li class="d-flex align-items-center">
              <div class="offcanvas__contact-icon mr-15">
                <i class="fal fa-envelope"></i>
              </div>
              <div class="offcanvas__contact-text">
                <a href={`mailto:${email}`}><span>{email}</span></a>
              </div>
            </li>
            <li class="d-flex align-items-center">
              <div class="offcanvas__contact-icon mr-15">
                <i class="fal fa-clock"></i>
              </div>
              <div class="offcanvas__contact-text">
                <a target="_blank" href="#">{hours}</a>
              </div>
            </li>
            <li class="d-flex align-items-center">
              <div class="offcanvas__contact-icon mr-15">
                <i class="far fa-phone"></i>
              </div>
              <div class="offcanvas__contact-text">
                <a href={`tel:${phone}`}>{phone}</a>
              </div>
            </li>
          </ul>
          
          <div class="header-button mt-4 text-center">
            <a href={ctaHref} class="theme-btn">
              {ctaText} <i class="fa-solid fa-arrow-right"></i>
            </a>
          </div>
          
          <div class="social-icon d-flex align-items-center">
            {socialLinks.map((link) => (
              <a href={link.href}>
                <i class={link.icon}></i>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<div class="offcanvas__overlay"></div>
