---
// Header Component
// Main navigation header with logo, menu and CTA

export interface Props {
  logoWhiteSrc: string;
  logoBlackSrc: string;
  navItems?: Array<{ label: string; href: string; active?: boolean; submenu?: Array<{ label: string; href: string }> }>;
  ctaHref?: string;
  ctaText?: string;
  searchEnabled?: boolean;
}

const {
  logoWhiteSrc,
  logoBlackSrc,
  navItems = [
    { label: 'Home', href: '/', active: true },
    { label: 'About', href: '/about' },
    { label: 'Services', href: '/services' },
    { label: 'Portfolio', href: '/portfolio' },
    { label: 'FAQ', href: '/faq' },
    { label: 'Contact', href: '/contact' }
  ],
  ctaHref = '/contact',
  ctaText = 'Lets Talk',
  searchEnabled = true
} = Astro.props;
---

<header class="header-1 header-3" id="header-sticky">
  <div class="container-fluid">
    <div class="mega-menu-wrapper">
      <div class="header-main">
        {/* Logo */}
        <div class="logo">
          <a href="/" class="header-logo">
            <img src={logoWhiteSrc} alt="logo-img" />
          </a>
          <div class="logo-2">
            <a href="/">
              <img src={logoBlackSrc} alt="" />
            </a>
          </div>
        </div>
        
        {/* Navigation Menu */}
        <div class="mean__menu-wrapper">
          <div class="main-menu style-2">
            <nav id="mobile-menu">
              <ul>
                {navItems.map((item) => (
                  item.submenu ? (
                    <li class="has-dropdown">
                      <a href="#">
                        {item.label}
                        <i class="fa-solid fa-chevron-down"></i>
                      </a>
                      <ul class="submenu">
                        {item.submenu.map((subitem) => (
                          <li><a href={subitem.href}>{subitem.label}</a></li>
                        ))}
                      </ul>
                    </li>
                  ) : (
                    <li class={item.active ? 'active' : ''}>
                      <a href={item.href} class={item.active ? 'border-none' : ''}>
                        {item.label}
                      </a>
                    </li>
                  )
                ))}
              </ul>
            </nav>
          </div>
        </div>
        
        {/* Header Right - Search + CTA + Hamburger */}
        <div class="header-right d-flex justify-content-end align-items-center">
          {searchEnabled && (
            <a href="#0" class="search-trigger search-icon">
              <i class="fa-regular fa-magnifying-glass"></i>
            </a>
          )}
          <a href={ctaHref} class="theme-btn style-2">
            {ctaText}
            <i class="fa-sharp fa-regular fa-arrow-right"></i>
          </a>
          <div class="header__hamburger d-xl-none my-auto">
            <div class="sidebar__toggle style-2">
              <i class="fas fa-bars"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>
