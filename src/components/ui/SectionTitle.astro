---
// SectionTitle Component
// Reusable section title with optional icon and subtitle

export interface Props {
  title: string;
  subtitle?: string;
  iconSrc?: string;
  align?: 'left' | 'center' | 'right';
  style?: 'default' | 'style-3';
  wowDelay?: string;
}

const { 
  title, 
  subtitle, 
  iconSrc, 
  align = 'left', 
  style = 'default',
  wowDelay = '.2s'
} = Astro.props;

const alignmentClass = align === 'center' ? 'text-center' : align === 'right' ? 'text-end' : '';
---

<div class={`section-title ${alignmentClass}`}>
  {subtitle && (
    <span class={`wow fadeInUp ${style}`} data-wow-delay=".1s">
      {iconSrc && <img src={iconSrc} alt="icon" />}
      {subtitle}
      {iconSrc && <img src={iconSrc} alt="icon" />}
    </span>
  )}
  <h2 class="wow fadeInUp" data-wow-delay={wowDelay}>{title}</h2>
</div>
