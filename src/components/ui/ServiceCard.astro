---
// ServiceCard Component
// Displays a single service with icon, title, description and link

export interface Props {
  icon: string;
  title: string;
  description: string;
  slug?: string;
  comingSoon?: boolean;
  wowDelay?: string;
}

const { 
  icon, 
  title, 
  description, 
  slug = '#',
  comingSoon = false,
  wowDelay = '.3s'
} = Astro.props;
---

<div class="col-lg-4 col-md-6">
  <div class="service-item wow fadeInUp" data-wow-delay={wowDelay}>
    <div class="icon">
      <img src={icon} alt="" />
    </div>
    <div class="content">
      <h4>
        {comingSoon ? (
          <span>{title}</span>
        ) : (
          <a href={slug}>{title}</a>
        )}
      </h4>
      <p>{description}</p>
    </div>
    {comingSoon ? (
      <span class="theme-btn disabled">
        Coming Soon
        <i class="fa-solid fa-lock"></i>
      </span>
    ) : (
      <a href={slug} class="theme-btn">
        Read More
        <i class="fa-solid fa-arrow-right"></i>
      </a>
    )}
  </div>
</div>
