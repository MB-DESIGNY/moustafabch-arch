---
// ProjectCard Component
// Displays a single project with image, category, title and link

export interface Props {
  coverImage: string;
  category: string;
  title: string;
  slug: string;
  bgClass?: string;
  wowDelay?: string;
}

const { 
  coverImage, 
  category, 
  title, 
  slug, 
  bgClass = '',
  wowDelay = '.2s'
} = Astro.props;
---

<div class={`box-2 ${bgClass} wow fadeInUp`} data-wow-delay={wowDelay}>
  <div class="project-content">
    <div class="text">
      <span>{category}</span>
      <h4><a href={slug}>{title}</a></h4>
    </div>
    <a href={slug} class="icon"><i class="fa-solid fa-arrow-right"></i></a>
  </div>
</div>
