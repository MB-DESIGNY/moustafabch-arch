---
// FeatureCard Component
// Displays a single feature with icon, title and description

export interface Props {
  iconSrc: string;
  title: string;
  description: string;
  href?: string;
  wowDelay?: string;
}

const { 
  iconSrc, 
  title, 
  description, 
  href = '#',
  wowDelay = '.3s'
} = Astro.props;
---

<div class="col-lg-4 col-md-6">
  <div class="feature-item wow fadeInUp" data-wow-delay={wowDelay}>
    <div class="icon">
      <img src={iconSrc} alt="icon" />
    </div>
    <div class="content">
      <h4><a href={href}>{title}</a></h4>
      <p>{description}</p>
    </div>
  </div>
</div>
