---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionTitle from '../../../components/ui/SectionTitle.astro';
import { getTranslations } from '../../../utils/i18n';

export async function getStaticPaths() {
  const services = await getCollection('services');
  
  return services.flatMap((service) => {
    // Generate a route for each language
    return ['ar', 'en', 'fr'].map(lang => ({
      params: { lang, slug: service.slug },
      props: { service, lang },
    }));
  });
}

const { service, lang } = Astro.props;
const t = await getTranslations(lang);

// Get localized content
const title = service.data.title[lang as 'ar'|'en'|'fr'];
const description = service.data.description[lang as 'ar'|'en'|'fr'];
const fullDescription = service.data.fullDescription?.[lang as 'ar'|'en'|'fr'] || description;
---

<BaseLayout
  lang={lang}
  dir={lang === 'ar' ? 'rtl' : 'ltr'}
  title={`${title} - Draft Studio`}
  description={description}
>
  <!-- Breadcrumb -->
  <section class="breadcrumb-area bread-bg bread-overlay">
    <div class="container">
      <div class="row">
        <div class="col-lg-12">
          <div class="bread-text">
            <h1 class="title">{title}</h1>
            <ul class="list">
              <li><a href={`/${lang}/`}>{t.common.home}</a></li>
              <li><span>/</span></li>
              <li><a href={`/${lang}/services/`}>{t.services.title}</a></li>
              <li><span>/</span></li>
              <li class="active">{title}</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Detail -->
  <section class="service-details pd-top-100 pd-bottom-70">
    <div class="container">
      <div class="row">
        <div class="col-lg-8">
          <div class="service-detail-content">
            <h2 class="mb-4">{title}</h2>
            <p class="lead">{description}</p>
            <div class="content-body mt-4">
              {fullDescription.split('\n').map((paragraph) => (
                <p class="mb-3">{paragraph}</p>
              ))}
            </div>
            
            {service.data.features && service.data.features[lang as 'ar'|'en'|'fr'] && (
              <div class="mt-5">
                <h3 class="h4 mb-3">{t.services.featuresTitle}</h3>
                <ul class="list-unstyled">
                  {service.data.features[lang as 'ar'|'en'|'fr'].map((feature: string) => (
                    <li class="mb-2">
                      <i class="fa fa-check-circle text-primary me-2"></i>
                      {feature}
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </div>
        
        <div class="col-lg-4">
          <aside class="sidebar">
            <div class="widget">
              <div class="icon-box text-center p-4 bg-light rounded">
                <img src={service.data.icon} alt={title} class="mb-3" style="width: 80px; height: 80px;" />
                <h4 class="h5">{title}</h4>
              </div>
            </div>
            
            <div class="widget mt-4">
              <h4 class="h5 mb-3">{t.services.otherServices}</h4>
              <ul class="list-group list-group-flush">
                {(await getCollection('services')).filter(s => s.slug !== service.slug).slice(0, 5).map((s) => (
                  <li class="list-group-item">
                    <a href={`/${lang}/services/${s.slug}`} class="text-decoration-none">
                      {s.data.title[lang as 'ar'|'en'|'fr']}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </aside>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
