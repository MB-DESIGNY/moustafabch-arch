---
// Static paths for language routes
export function getStaticPaths() {
  return [
    { params: { lang: 'ar' } }, // Arabic (default, RTL)
    { params: { lang: 'en' } }, // English
    { params: { lang: 'fr' } }, // French
  ];
}

// Get current language from params
const { lang } = Astro.params;
const dir = lang === 'ar' ? 'rtl' : 'ltr';

// Load translations
import { getTranslations } from '../../utils/i18n';
const t = await getTranslations(lang);

// Load content collections
import { getCollection } from 'astro:content';
const allServices = await getCollection('services');
const allProjects = await getCollection('projects');

// Filter active services and featured projects
const activeServices = allServices
  .filter((s) => !s.data.comingSoon)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);

const displayProjects = allProjects
  .filter((p) => p.data.featured)
  .slice(0, 4);

// Import layouts and components
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import HeroSection from '../../components/sections/HeroSection.astro';
import FeatureSection from '../../components/sections/FeatureSection.astro';
import AboutSection from '../../components/sections/AboutSection.astro';
import ServicesSection from '../../components/sections/ServicesSection.astro';
import ProjectsSection from '../../components/sections/ProjectsSection.astro';
import FunfactSection from '../../components/sections/FunfactSection.astro';
import ClientSection from '../../components/sections/ClientSection.astro';
import TestimonialsSection from '../../components/sections/TestimonialsSection.astro';
---

<BaseLayout lang={lang} dir={dir} title={t.home.title} description={t.home.description}>
  <Header lang={lang} dir={dir} translations={t} />
  
  <!-- Hero Section -->
  <HeroSection
    subtitle={t.hero.subtitle}
    title={t.hero.title}
    description={t.hero.description}
    cvDownloadHref="/assets/pdf/CV_Mustapha_Benchabane.pdf"
    downloadText={t.hero.downloadCV}
    contactHref={`/${lang}/contact/`}
    contactText={t.hero.contactMe}
    socialLinks={[
      { href: 'https://behance.net/mustaphabenchabane', iconClass: 'fab fa-behance' },
      { href: 'https://dribbble.com/mustaphabenchabane', iconClass: 'fab fa-dribbble' },
      { href: 'https://instagram.com/draft.studio', iconClass: 'fab fa-instagram' },
      { href: 'https://linkedin.com/in/mustaphabenchabane', iconClass: 'fab fa-linkedin-in' },
      { href: 'https://github.com/mustaphabenchabane', iconClass: 'fab fa-github' },
    ]}
  />
  
  <!-- Feature Section -->
  <FeatureSection
    title={t.feature.title}
    cards={[
      { iconSrc: '/assets/img/icon/feature-icon-1.svg', title: t.feature.cards[0].title, description: t.feature.cards[0].description },
      { iconSrc: '/assets/img/icon/feature-icon-2.svg', title: t.feature.cards[1].title, description: t.feature.cards[1].description },
      { iconSrc: '/assets/img/icon/feature-icon-3.svg', title: t.feature.cards[2].title, description: t.feature.cards[2].description },
    ]}
  />
  
  <!-- About Section -->
  <AboutSection
    subtitle={t.about.subtitle}
    title={t.about.title}
    description={t.about.description}
    experienceYears="7"
    projectsCompleted="297+"
    clientsCount="138"
    satisfactionRate="97%"
    statsLabels={{
      experience: t.about.stats.experience,
      projects: t.about.stats.projects,
      clients: t.about.stats.clients,
      satisfaction: t.about.stats.satisfaction,
    }}
  />
  
  <!-- Services Section -->
  <ServicesSection
    subtitle={t.services.subtitle}
    title={t.services.title}
    viewAllHref={`/${lang}/services/`}
    viewAllText={t.services.viewAll}
    comingSoonLabel={t.services.comingSoon}
    services={activeServices.map((s) => ({
      slug: s.slug,
      title: s.data.title[lang],
      icon: s.data.icon,
      shortDescription: s.data.shortDescription[lang],
      comingSoon: s.data.comingSoon,
    }))}
  />
  
  <!-- Projects Section -->
  <ProjectsSection
    subtitle={t.projects.subtitle}
    title={t.projects.title}
    viewAllHref={`/${lang}/portfolio/`}
    viewAllText={t.projects.viewAll}
    featuredLabel={t.projects.featured}
    projects={displayProjects.map((p) => ({
      slug: p.slug,
      title: p.data.title[lang],
      category: p.data.category,
      coverImage: p.data.coverImage,
      location: p.data.location?.[lang] || '',
      year: p.data.year || '',
    }))}
  />
  
  <!-- Funfact Section -->
  <FunfactSection
    funfacts={[
      { count: 7, suffix: '+', label: t.funfact.yearsExperience, iconSrc: '/assets/img/icon/counter-icon-1.svg' },
      { count: 297, suffix: '+', label: t.funfact.projectsCompleted, iconSrc: '/assets/img/icon/counter-icon-2.svg' },
      { count: 138, suffix: '', label: t.funfact.happyClients, iconSrc: '/assets/img/icon/counter-icon-3.svg' },
      { count: 97, suffix: '%', label: t.funfact.satisfactionRate, iconSrc: '/assets/img/icon/counter-icon-4.svg' },
    ]}
  />
  
  <!-- Client Section -->
  <ClientSection
    title={t.client.title}
    activeClientsCount="138"
    activeClientsLabel={t.client.activeClients}
  />
  
  <!-- Testimonials Section -->
  <TestimonialsSection
    title={t.testimonial.title}
    ratingLabel={t.testimonial.rating}
    testimonials={[]}
  />
  
  <Footer lang={lang} dir={dir} translations={t} />
</BaseLayout>
