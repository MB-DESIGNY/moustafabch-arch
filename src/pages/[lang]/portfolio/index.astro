---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectCard from '../../../components/ui/ProjectCard.astro';
import SectionTitle from '../../../components/ui/SectionTitle.astro';
import { getTranslations } from '../../../utils/i18n';

export async function getStaticPaths({ lang }: { lang: string }) {
  const projects = await getCollection('projects');
  const t = await getTranslations(lang);

  return [
    {
      params: { lang },
      props: { 
        projects, 
        t,
        pageTitle: t.projects.pageTitle,
        pageDescription: t.projects.pageDescription
      },
    },
  ];
}

const { projects, t, pageTitle, pageDescription } = Astro.props;
---

<BaseLayout
  lang={Astro.params.lang!}
  dir={Astro.params.lang === 'ar' ? 'rtl' : 'ltr'}
  title={pageTitle}
  description={pageDescription}
>
  <!-- Breadcrumb -->
  <section class="breadcrumb-area bread-bg bread-overlay">
    <div class="container">
      <div class="row">
        <div class="col-lg-12">
          <div class="bread-text">
            <h1 class="title">{t.projects.title}</h1>
            <ul class="list">
              <li><a href={`/${Astro.params.lang}/`}>{t.common.home}</a></li>
              <li><span>/</span></li>
              <li class="active">{t.projects.title}</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Projects Grid -->
  <section class="project-section pd-top-100 pd-bottom-70">
    <div class="container">
      <SectionTitle 
        subtitle={t.projects.subtitle}
        title={t.projects.mainTitle}
        description={t.projects.description}
      />
      
      <div class="row justify-content-center">
        {projects.map((project) => (
          <div class="col-lg-4 col-md-6 mb-4">
            <ProjectCard 
              title={project.data.title[Astro.params.lang as 'ar'|'en'|'fr']}
              category={project.data.category[Astro.params.lang as 'ar'|'en'|'fr']}
              coverImage={project.data.coverImage}
              slug={`/${Astro.params.lang}/portfolio/${project.slug}`}
            />
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
