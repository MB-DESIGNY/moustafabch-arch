---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionTitle from '../../components/ui/SectionTitle.astro';
import { getTranslations } from '../../utils/i18n';

export async function getStaticPaths({ lang }: { lang: string }) {
  const t = await getTranslations(lang);

  return [
    {
      params: { lang },
      props: { 
        t,
        pageTitle: t.faq.pageTitle,
        pageDescription: t.faq.pageDescription
      },
    },
  ];
}

const { t, pageTitle, pageDescription } = Astro.props;
---

<BaseLayout
  lang={Astro.params.lang!}
  dir={Astro.params.lang === 'ar' ? 'rtl' : 'ltr'}
  title={pageTitle}
  description={pageDescription}
>
  <!-- Breadcrumb -->
  <section class="breadcrumb-area bread-bg bread-overlay">
    <div class="container">
      <div class="row">
        <div class="col-lg-12">
          <div class="bread-text">
            <h1 class="title">{t.faq.title}</h1>
            <ul class="list">
              <li><a href={`/${Astro.params.lang}/`}>{t.common.home}</a></li>
              <li><span>/</span></li>
              <li class="active">{t.faq.title}</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="faq-section pd-top-100 pd-bottom-70">
    <div class="container">
      <SectionTitle 
        subtitle={t.faq.subtitle}
        title={t.faq.mainTitle}
        description={t.faq.description}
      />
      
      <div class="row justify-content-center">
        <div class="col-lg-10">
          <div class="accordion" id="faqAccordion">
            {t.faq.questions.map((qa: { q: string; a: string }, index: number) => (
              <div class="card mb-3 border-0 shadow-sm">
                <div class="card-header p-0" id={`heading${index}`}>
                  <h5 class="mb-0">
                    <button 
                      class="btn btn-link btn-block text-left w-100 p-3" 
                      type="button" 
                      data-toggle="collapse" 
                      data-target={`#collapse${index}`}
                      aria-expanded={index === 0 ? 'true' : 'false'}
                      aria-controls={`collapse${index}`}
                      style="text-decoration: none; color: inherit;"
                    >
                      <div class="d-flex justify-content-between align-items-center">
                        <span class="font-weight-bold">{qa.q}</span>
                        <i class="fa fa-chevron-down"></i>
                      </div>
                    </button>
                  </h5>
                </div>
                <div 
                  id={`collapse${index}`} 
                  class={`collapse ${index === 0 ? 'show' : ''}`} 
                  aria-labelledby={`heading${index}`} 
                  data-parent="#faqAccordion"
                >
                  <div class="card-body p-4">
                    {qa.a}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
